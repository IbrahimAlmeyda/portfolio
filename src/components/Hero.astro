---
import CatIcon from "../components/CatIcon.astro";
import HeroArt from "../components/HeroArt.astro";

const words = "Construyo software que se usa de verdad".split(" ");
---

<section id="inicio" class="hero grid-bg crop-marks">
  <div class="glow" aria-hidden="true"></div>
  <div class="sweep" aria-hidden="true"></div>
  <div class="container inner">
    <div class="copy">
      <p class="label lable--accent">[0][0] Desarrollador Full Stack</p>
      <h1 aria-label={words.join(" ")}>
        {
          words.map((w, i) => (
            <Fragment>
              <span class="w" aria-hidden="true">
                <span style={`--k:${i}`}>{w}</span>
              </span>{" "}
            </Fragment>
          ))
        }
      </h1>
      <p class="lead">
        Aplicaciones web con React, Node y PostgreSQL. Convierto procesos
        manuales en herramientas que la gente usa todos los días.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="#proyectos">Ver proyectos ↓</a>
        <a class="btn" href="#contacto">Contacto</a>
      </div>
    </div>

    <div class="art-slot"><HeroArt /></div>

    <aside class="spec" aria-label="Resumen">
      <div class="spec__head">
        <span>FICHA</span><span>PORTAFOLIO 2026</span>
      </div>
      <dl class="spec__list">
        <div><dt>Nombre</dt><dd>Ibrahim Almeyda</dd></div>
        <div><dt>Rol</dt><dd>Full Stack Developer</dd></div>
        <div>
          <dt>Ubicación</dt><dd>
            <span class="loc">Chincha, Perú <CatIcon /></span>
          </dd>
        </div>
        <div><dt>Stack</dt><dd>React · Node · PostgreSQL</dd></div>
        <div>
          <dt>Estado</dt><dd>
            <span class="status"><i></i>Trabajemos juntos</span>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-block: var(--space-7);
    border-bottom: var(--border-w) solid var(--color-line);
  }
  .inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-7) var(--space-8);
    align-items: center;
  }
  .copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  h1 {
    max-width: 16ch;
  }
  .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .w > span {
    display: inline-block;
    animation: rise 950ms cubic-bezier(0.2, 0.8, 0.2, 1)
      calc(var(--k) * 110ms + 350ms) both;
  }
  @keyframes rise {
    from {
      transform: translateY(112%);
    }
  }
  .lead {
    max-width: 38rem;
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    animation: up 800ms var(--ease) 1.1s both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    animation: up 800ms var(--ease) 1.3s both;
  }
  .copy > .label {
    animation: up 700ms var(--ease) 0.1s both;
  }
  @keyframes up {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  /* Plano del logo: en móvil queda de fondo, en escritorio a la derecha */
  .art-slot {
    position: absolute;
    z-index: 0;
    right: -7rem;
    top: 0;
    width: 24rem;
    opacity: 0.55;
    pointer-events: none;
  }

  /* Efecto del cursor y línea de plóter */
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms var(--ease);
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--color-accent) 75%, transparent) var(--border-w),
        transparent var(--border-w)
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-accent) 75%, transparent) var(--border-w),
        transparent var(--border-w)
      );
    background-size: var(--grid-size) var(--grid-size);
    background-position: center;
    mask-image: radial-gradient(
      circle 15rem at var(--mx, 50%) var(--my, 50%),
      #000,
      transparent
    );
  }
  .hero.is-hover .glow {
    opacity: 1;
  }
  .sweep {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    width: 2px;
    opacity: 0;
    pointer-events: none;
    background: var(--color-accent);
    box-shadow: -4rem 0 6rem 1.5rem
      color-mix(in srgb, var(--color-accent) 16%, transparent);
    animation: sweep 1.7s cubic-bezier(0.65, 0, 0.35, 1) 0.15s both;
  }
  @keyframes sweep {
    0% {
      transform: translateX(-10vw);
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateX(105vw);
      opacity: 0;
    }
  }

  /* Cajetín */
  .spec {
    position: relative;
    z-index: 1;
    border: var(--border-w) solid var(--color-ink);
    background: var(--color-bg);
    animation: up 900ms var(--ease) 1s both;
  }
  .spec__head {
    display: flex;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--color-ink);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
  }
  .spec__list {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .spec__list > div {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-top: var(--border-w) solid var(--color-line);
    animation: fade 700ms var(--ease) 1.6s both;
  }
  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--color-ink-3);
  }
  dd {
    margin: 0;
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .loc,
  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .status i {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--color-accent);
    animation: pulse 2s var(--ease) infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  @media (min-width: 62.01rem) {
    .inner {
      grid-template-columns: 1.3fr 1fr;
      grid-template-areas: "copy art" "spec spec";
    }
    .copy {
      grid-area: copy;
    }
    .art-slot {
      position: static;
      grid-area: art;
      justify-self: end;
      width: min(100%, 30rem);
      opacity: 1;
    }
    .spec {
      grid-area: spec;
      display: grid;
      grid-template-columns: 9rem 1fr;
    }
    .spec__head {
      flex-direction: column;
      justify-content: space-between;
    }
    .spec__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .spec__list > div {
      border-top: 0;
      border-left: var(--border-w) solid var(--color-line);
      padding: var(--space-4);
    }
    .spec__list > div:first-child {
      border-left: 0;
    }
  }
</style>

<script>
  const hero = document.getElementById("inicio");

  hero?.addEventListener("pointermove", (e: PointerEvent) => {
    if (e.pointerType === "touch") return;
    const r = hero.getBoundingClientRect();
    hero.style.setProperty("--mx", `${e.clientX - r.left}px`);
    hero.style.setProperty("--my", `${e.clientY - r.top}px`);
    hero.classList.add("is-hover");
  });

  hero?.addEventListener("pointerleave", () =>
    hero.classList.remove("is-hover"),
  );
</script>
