---
import CatIcon from "../components/CatIcon.astro";
import { useTranslations, defaultLang, type Lang, type UIKey } from "../i18n/ui";

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const hard = [
  {
    group: t("about.hard.frontend"),
    items: ["HTML", "CSS", "JavaScript", "TypeScript", "Tailwind", "Astro", "React"],
  },
  {
    group: t("about.hard.backend"),
    items: ["Node.js", "Express", t("about.hard.backend.rest")],
  },
  { group: t("about.hard.data"), items: ["PostgreSQL", "Neon"] },
  {
    group: t("about.hard.tools"),
    items: ["Linux / WSL", "Git", "GitHub", "Docker", "Jira", "Claude Code"],
  },
];
const soft = [1, 2, 3, 4].map((n) => ({
  t: t(`about.soft${n}.t` as UIKey),
  d: t(`about.soft${n}.d` as UIKey),
}));
const facts = [
  { k: t("about.fact.loc"), v: t("about.fact.locv"), cat: true },
  { k: t("about.fact.lang"), v: t("about.fact.langv") },
  { k: t("about.fact.avail"), v: t("about.fact.availv") },
];
---

<section id="sobre-mi" class="section alt">
  <div class="container about">
    <div class="intro">
      <p class="label label--accent">{t("about.label")}</p>
      <h2>{t("about.title")}</h2>
      <p>{t("about.p1")}</p>
      <p>{t("about.p2")}</p>
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <>
                <dt>{f.k}</dt>
                <dd>
                  <span class="loc">
                    {f.v}
                    {f.cat && <CatIcon />}
                  </span>
                </dd>
              </>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="skills">
      <div>
        <h3>{t("about.hard")}</h3>
        {
          hard.map((g) => (
            <div class="group">
              <p class="label">{g.group}</p>
              <p class="chips">
                {g.items.map((i) => (
                  <span class="chip">{i}</span>
                ))}
              </p>
            </div>
          ))
        }
      </div>
      <div>
        <h3>{t("about.soft")}</h3>
        <ol class="soft">
          {
            soft.map((s, i) => (
              <li>
                <>
                  <span class="label">[0{i + 1}]</span>
                  <div>
                    <>
                      <strong>{s.t}</strong>
                      <p>{s.d}</p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-7);
  }
  .alt {
    background: var(--color-surface);
    border-block: var(--border-w) solid var(--color-line);
  }
  .about {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 62.01rem) {
    .about {
      grid-template-columns: 1fr 1.2fr;
    }
  }
  .intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .intro p {
    margin: 0;
    max-width: 34rem;
  }
  .facts {
    margin: var(--space-3) 0 0;
    border-top: var(--border-w) solid var(--color-line);
  }
  .facts > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: var(--border-w) solid var(--color-line);
  }
  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    color: var(--color-ink-3);
  }
  dd {
    margin: 0;
    color: var(--color-ink);
  }
  .loc {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .skills {
    display: grid;
    gap: var(--space-7);
  }
  h3 {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-w) solid var(--color-ink);
  }
  .group {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .group .label {
    margin: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }
  .soft {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .soft li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3);
  }
  .soft strong {
    color: var(--color-ink);
    font-weight: var(--weight-semibold);
  }
  .soft p {
    margin: var(--space-1) 0 0;
    color: var(--color-ink-3);
    font-size: var(--text-sm);
  }
</style>
